# Optional for laptop: leave blank to generate data/operator.key (keep private).
ZENITH_API_KEY=
ZENITH_DATA=data
# Leave DATABASE_URL unset for SQLite. Compose supplies PostgreSQL.
# Supabase: copy its Session pooler URL, use postgresql+psycopg:// and sslmode=require.
# DATABASE_URL=postgresql+psycopg://USER:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# PostgreSQL tables default to this private schema; keep it out of Supabase's exposed schemas.
DATABASE_SCHEMA=zenith_private
ZENITH_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=180
# Comma-separated approved contacts. Blank means no email routing.
ZENITH_RECIPIENTS=
# Both values required to send. Otherwise the outbox remains preview-only.
RESEND_API_KEY=
ZENITH_FROM_EMAIL=
# Telegram alerts (server-side only; never use a VITE_ prefix).
# Create a bot with @BotFather, press Start on it from each chat, then list numeric chat IDs.
# If a token is ever exposed, run /revoke in @BotFather before using the bot again.
TELEGRAM_BOT_TOKEN=
ZENITH_TELEGRAM_CHATS=
# Attach one saved evidence frame to each Telegram alert. This sends footage off this machine.
TELEGRAM_SEND_EVIDENCE=false
# Base network-camera clip length in seconds. Zone clips grow to cover dwell + 2 s.
ZENITH_CAMERA_CLIP_SECONDS=5
# Compose requires a PostgreSQL password. Use a long random alphanumeric value.
POSTGRES_PASSWORD=

# Optional Supabase browser project values (NOT the backend database password).
# Auth/Storage client integration is not wired yet. These replace NEXT_PUBLIC_ names in Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only NVIDIA API Catalog credential. Hosted review also requires explicit consent.
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
VISION_PROVIDER=off
VISION_SEND_TO_THIRD_PARTY=false
LOCAL_VLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_VLM_MODEL=qwen2.5vl:3b
LOCAL_VLM_API_KEY=
VISION_TIMEOUT=30
VISION_MAX_FRAMES=1
